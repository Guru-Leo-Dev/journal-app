# Copy this file to .env and paste your Supabase connection string.
PORT=3000

# Supabase dashboard -> Connect -> "Session pooler" string for running on your laptop (port 5432, IPv4).
# On Vercel use the "Transaction pooler" string instead (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
# If the password has special characters (@ : / # ? %), URL-encode them (e.g. @ -> %40),
# or just reset it to letters+numbers only.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- How people sign in ---
#   local  = username + password, stored (hashed) in your database. No Google needed.  <- default
#   google = "Continue with Google" through Supabase Auth
#   both   = show both options
AUTH_MODE=local

# Local sign-in: set to false once you've created your account, to stop strangers registering.
ALLOW_SIGNUP=true
# Local sign-in: the username that receives your old "leo" pages (default: leo).
OWNER_USERNAME=leo
# Optional: a long random string that signs login tokens. If blank, one is created in .session-secret
# SESSION_SECRET=

# --- Google sign-in (only when AUTH_MODE is google or both) ---
# Supabase dashboard -> Project Settings -> API Keys (or the "Connect" dialog).
# Both values are safe to be public; they are NOT the database password.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here

# Your own Google email. Pages you wrote before sign-in existed (saved as "leo") are moved
# into YOUR account the first time you sign in with this email. Leave blank if you have none.
OWNER_EMAIL=you@gmail.com
JOURNAL_NAME=leo

# Only needed once, if you want to copy your existing local MySQL pages to Supabase
# (npm run migrate). Safe to delete afterwards.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=sparse_musings
